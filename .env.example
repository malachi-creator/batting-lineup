# Copy to .env for local dev. On Netlify, set these as site environment variables
# (Site settings → Environment variables). VITE_* vars are baked in at build time.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only if you add Firebase Analytics later
# VITE_FIREBASE_MEASUREMENT_ID=

# Netlify functions only (also set in Netlify env — not needed for `npm run dev` unless using netlify dev)
# FIREBASE_PROJECT_ID=beer-pressure-e2720
# FIREBASE_API_KEY=              # same as VITE_FIREBASE_API_KEY
# ANTHROPIC_API_KEY=
